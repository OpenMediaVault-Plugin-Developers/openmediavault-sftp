msgid "Settings"
msgstr "Inställningar"

msgid "Sftp"
msgstr "SFTP"

msgid "Shared folder"
msgstr "Delad mapp"

msgid "Shared folder to give user access to when connecting via sftp."
msgstr "Delad mapp som användaren får åtkomst till vid anslutning via SFTP."

msgid "Shares"
msgstr "Delningar"

msgid "Username"
msgstr "Användarnamn"

msgid "n/a"
msgstr "Ej tillgängligt"

