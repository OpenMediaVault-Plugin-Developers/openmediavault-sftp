msgid "Allow access to sftp-access group only"
msgstr "Tillåt endast åtkomst för gruppen sftp-access"

msgid "AllowGroups"
msgstr "AllowGroups"

msgid "An SFTP share for the user '%s' and this shared folder already exists."
msgstr ""
"Det finns redan en SFTP-delning för användaren ”%s” och den här delade "
"mappen."

msgid "Create"
msgstr "Skapa"

msgid "Created share."
msgstr "Delningen har skapats."

msgid "Date & Time"
msgstr "Datum och tid"

msgid "Edit"
msgstr "Redigera"

msgid "Edit share."
msgstr "Redigera delningen."

msgid "Enable"
msgstr "Aktivera"

msgid "Enable keyboard-interactive authentication."
msgstr "Aktivera tangentbordsinteraktiv autentisering."

msgid "Enable public key authentication."
msgstr "Aktivera autentisering med publik nyckel."

msgid "Extra options"
msgstr "Extra inställningar"

msgid "Hostname"
msgstr "Värdnamn"

msgid "Log chrooted sessions"
msgstr ""

msgid ""
"Log the SFTP sessions of chrooted users (members of the sftp-access group) "
"to the system journal. Shown in the SFTP log."
msgstr ""

msgid "Message"
msgstr "Meddelande"

msgid "Password authentication"
msgstr "Lösenordsautentisering"

msgid ""
"Please check the <a href='http://www.openbsd.org/cgi-"
"bin/man.cgi?query=sshd_config&sektion=5' target='_blank'>manual page</a> for"
" more details."
msgstr ""
"Mer information finns på <a href='http://www.openbsd.org/cgi-"
"bin/man.cgi?query=sshd_config&sektion=5' target='_blank'>manualsidan</a>."

